#!/usr/bin/env bash
# A fake `tailscale` for the provision wizard's tests: the one on the maintainer's computer, signed
# in to the tailnet that the machines in $DEADLIFT_TEST_WORLD/machines/ join (see ./ssh). It answers
# only `tailscale status --json`, listing each joined machine as a peer with its tags, as
# Tailscale shows a device the maintainer's computer can reach. Anything else fails.
set -euo pipefail

world=${DEADLIFT_TEST_WORLD:?the fake tailscale needs DEADLIFT_TEST_WORLD}
printf '%s\n' "$*" >>"$world/tailscale.log"

if [[ $* != "status --json" ]]; then
  echo "fake tailscale: the wizard has no reason to run 'tailscale $*' here" >&2
  exit 1
fi

peers='{}'
for machine in "$world"/machines/*; do
  [[ -f $machine/hostname ]] || continue
  peers=$(jq --arg name "$(<"$machine/hostname")" --rawfile tags "$machine/tags" \
    '. + {("key:" + $name): {HostName: $name, Tags: ($tags | split("\n") | map(select(. != "")))}}' \
    <<<"$peers")
done
# Pretty-printed, as the real one prints it.
jq -n --argjson peers "$peers" \
  '{Self: {HostName: "maintainers-laptop"}, MagicDNSSuffix: "tailtest.ts.net", Peer: $peers}'
