#!/usr/bin/env bash
# A fake `tailscale` for the Seam A tests, installed on the fake Server's PATH ahead of any real
# one. It answers only what deadlift asks of Tailscale on a Server, keeping each Service's Serve
# mappings as Tailscale would:
#
#   tailscale status --json                                   the tailnet's MagicDNS suffix
#   tailscale serve --service=svc:<app> --https=<port> [--bg] <target>   map a port
#   tailscale serve --service=svc:<app> --https=<port> off    unmap it; fails when it isn't mapped
#   tailscale serve status --json                             every Service's mappings
#   tailscale serve clear svc:<app>                           unmap every port of the Service
#
# Every call is logged, and anything else fails, so a call deadlift shouldn't make shows up.
# Its state lives beside the fake Server's bin directory, in tailscale/.
set -euo pipefail

state=$(cd "$(dirname "$0")/.." && pwd)/tailscale
mkdir -p "$state"
mappings=$state/serve
touch "$mappings"
printf '%s\n' "$*" >>"$state/calls.log"

suffix=tailtest.ts.net

if [[ $* == "status --json" ]]; then
  jq -n --arg suffix "$suffix" '{MagicDNSSuffix: $suffix}'
  exit 0
fi

if [[ $* == "serve status --json" ]]; then
  jq -Rn --arg suffix "$suffix" '
    [inputs | split(" ") | {service: .[0], port: .[1], target: .[2]}]
    | if length == 0 then {} else
        {Services: (group_by(.service) | map({
          key: .[0].service,
          value: {
            TCP: (map({key: .port, value: {HTTPS: true}}) | from_entries),
            Web: (map({
              key: "\(.service | ltrimstr("svc:")).\($suffix):\(.port)",
              value: {Handlers: {"/": {Proxy: .target}}}
            }) | from_entries)
          }
        }) | from_entries)}
      end' <"$mappings"
  exit 0
fi

if [[ ${1:-} == serve && ${2:-} == clear && ${3:-} == svc:* && $# == 3 ]]; then
  grep -v "^$3 " "$mappings" >"$mappings.new" || true
  mv "$mappings.new" "$mappings"
  exit 0
fi

if [[ ${1:-} == serve ]]; then
  shift
  service='' port='' target=''
  for arg in "$@"; do
    case $arg in
      --service=svc:*) service=${arg#--service=} ;;
      --https=*) port=${arg#--https=} ;;
      --bg) ;;
      -*) echo "fake tailscale: unknown flag $arg" >&2 && exit 1 ;;
      *) target=$arg ;;
    esac
  done
  if [[ -z $service || -z $port || -z $target ]]; then
    echo "fake tailscale: serve needs --service=svc:<name>, --https=<port> and a target" >&2
    exit 1
  fi
  others=$(grep -v "^$service $port " "$mappings" || true)
  if [[ $target == off ]]; then
    if ! grep -q "^$service $port " "$mappings"; then
      echo "error: handler does not exist" >&2
      exit 1
    fi
    printf '%s' "${others:+$others$'\n'}" >"$mappings.new"
  else
    printf '%s%s %s %s\n' "${others:+$others$'\n'}" "$service" "$port" "$target" >"$mappings.new"
  fi
  mv "$mappings.new" "$mappings"
  exit 0
fi

echo "fake tailscale: deadlift has no reason to run 'tailscale $*'" >&2
exit 1
