#!/usr/bin/env python3
"""A fake `tailscale` for the provision wizard's tests: the one on the maintainer's computer,
signed in to the tailnet that the machines in $DEADLIFT_TEST_WORLD/machines/ join (see ./ssh).
It answers only `tailscale status --json`, listing each joined machine as a peer with its tags,
as Tailscale shows a device the maintainer's computer can reach. Anything else fails. Standard
library only.
"""

import json
import os
import sys
from pathlib import Path


def say(text: str) -> None:
    sys.stderr.write(f"{text}\n")


def main(argv: list[str]) -> int:
    world_dir = os.environ.get("DEADLIFT_TEST_WORLD")
    if not world_dir:
        say("DEADLIFT_TEST_WORLD: the fake tailscale needs DEADLIFT_TEST_WORLD")
        return 1
    world = Path(world_dir)
    with (world / "tailscale.log").open("a") as log:
        log.write(" ".join(argv) + "\n")

    if argv != ["status", "--json"]:
        say(f"fake tailscale: the wizard has no reason to run 'tailscale {' '.join(argv)}' here")
        return 1

    peers: dict[str, object] = {}
    for machine in sorted((world / "machines").iterdir()):
        if not (machine / "hostname").is_file():
            continue
        name = (machine / "hostname").read_text().rstrip("\n")
        try:
            tags = (machine / "tags").read_text()
        except FileNotFoundError:
            say(f"fake tailscale: {machine / 'tags'} is missing")
            return 2
        peers[f"key:{name}"] = {"HostName": name, "Tags": [tag for tag in tags.split("\n") if tag]}
    status = {
        "Self": {"HostName": "maintainers-laptop"},
        "MagicDNSSuffix": "tailtest.ts.net",
        "Peer": peers,
    }
    # Pretty-printed, as the real one prints it.
    sys.stdout.write(json.dumps(status, indent=2, ensure_ascii=False) + "\n")
    return 0


sys.exit(main(sys.argv[1:]))
