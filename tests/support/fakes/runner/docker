#!/usr/bin/env bash
# A fake `docker` on a fake CI runner, ahead of any real one, for testing the build action. It
# stands in for the Docker CLI and the registries it pushes to, and never touches Docker:
#
#   docker login <registry> --username <user> --password-stdin
#       Saves the login in $DOCKER_CONFIG (or ~/.docker), as the real one does.
#   docker buildx build [--platform p] [--provenance=bool] [--sbom=bool] [--label k=v]...
#                       [--file f] [--target t] [--tag ref]... [--push] [--quiet] <context>
#       Fails, as the real one does, when the Dockerfile isn't there, or when pushing to a
#       registry without a login. With --push, records each tag as pushed.
#
# State, in $FAKE_RUNNER_STATE: pushed.jsonl, one line per pushed tag: the ref, who pushed it
# (registry, username and password of the login), and how it was built.
set -euo pipefail

state=${FAKE_RUNNER_STATE:?the fake docker needs FAKE_RUNNER_STATE}
printf 'docker %s\n' "$*" >>"$state/calls.log"
config=${DOCKER_CONFIG:-$HOME/.docker}

case "${1:-} ${2:-}" in
  login\ *)
    registry=$2 username='' password=''
    shift 2
    while (($#)); do
      case $1 in
        --username) username=$2 && shift 2 ;;
        --password-stdin) password=$(cat) && shift ;;
        *) echo "fake docker: login doesn't take $1" >&2 && exit 125 ;;
      esac
    done
    mkdir -p "$config"
    existing=$(cat "$config/config.json" 2>/dev/null || echo '{}')
    jq --arg r "$registry" --arg u "$username" --arg p "$password" \
      '.auths[$r] = {username: $u, password: $p}' <<<"$existing" >"$config/config.json"
    echo "Login Succeeded"
    ;;
  "buildx build")
    shift 2
    tags=() labels=() platform='' provenance=true sbom=true file='' target='' push=false context=''
    while (($#)); do
      case $1 in
        --platform) platform=$2 && shift 2 ;;
        --provenance=*) provenance=${1#*=} && shift ;;
        --sbom=*) sbom=${1#*=} && shift ;;
        --label) labels+=("$2") && shift 2 ;;
        --file) file=$2 && shift 2 ;;
        --target) target=$2 && shift 2 ;;
        --tag) tags+=("$2") && shift 2 ;;
        --push) push=true && shift ;;
        --quiet) shift ;;
        -*) echo "fake docker: buildx build doesn't take $1" >&2 && exit 125 ;;
        *) context=$1 && shift ;;
      esac
    done
    [[ -n $context ]] || { echo "ERROR: docker buildx build requires 1 argument" >&2 && exit 1; }
    dockerfile=${file:-$context/Dockerfile}
    if [[ ! -f $dockerfile ]]; then
      echo "ERROR: failed to build: failed to read dockerfile: open $dockerfile: no such file or directory" >&2
      exit 1
    fi
    if [[ $push == false ]]; then exit 0; fi
    for tag in "${tags[@]}"; do
      registry=${tag%%/*}
      login=$(jq -c --arg r "$registry" '.auths[$r] // empty' "$config/config.json" 2>/dev/null || true)
      if [[ -z $login ]]; then
        echo "ERROR: failed to push $tag: unauthorized" >&2
        exit 1
      fi
      jq -nc --arg ref "$tag" --argjson login "$login" --arg registry "$registry" \
        --arg platform "$platform" --arg provenance "$provenance" --arg sbom "$sbom" \
        --arg dockerfile "$dockerfile" --arg context "$context" --arg target "$target" \
        '{ref: $ref, login: ($login + {registry: $registry}), platform: $platform,
          provenance: $provenance, sbom: $sbom, context: $context, dockerfile: $dockerfile,
          target: $target, labels: $ARGS.positional}' --args -- "${labels[@]}" >>"$state/pushed.jsonl"
    done
    echo "sha256:$(printf '%s' "${tags[*]}" | sha256sum | cut -c1-64)"
    ;;
  *)
    echo "fake docker: the build action has no reason to run 'docker $*'" >&2
    exit 125
    ;;
esac
