#!/usr/bin/env bash
# A fake `sudo` on the fake Server, for the delivery tests. It plays the one rule `deadlift app add`
# installs for each App's deploy user:
#
#   deadlift-<app> ALL=(root) NOPASSWD: /usr/local/sbin/deadlift-entry
#
# so it runs only the entry command, as installed on this fake Server, with SUDO_USER set to the
# user who logged in and the environment reset, as sudo's env_reset does. The fake Server's
# server.env adds what a real Server has at fixed paths: where its state and installed scripts are.
set -euo pipefail

server=${DEADLIFT_TEST_SERVER:?}
user=${DEADLIFT_TEST_LOGIN:?}

while [[ ${1:-} == -n || ${1:-} == --non-interactive ]]; do shift; done
if [[ ${1:-} != /usr/local/sbin/deadlift-entry ]]; then
  echo "Sorry, user $user is not allowed to execute '$*' as root." >&2
  exit 1
fi
shift

env=(
  PATH="$server/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  HOME="$server/home"
  SUDO_USER="$user"
)
if [[ -n ${DOCKER_HOST:-} ]]; then env+=(DOCKER_HOST="$DOCKER_HOST"); fi
mapfile -t settings <"$server/server.env"
exec env -i "${env[@]}" "${settings[@]}" "$server/sbin/deadlift-entry" "$@"
