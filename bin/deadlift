#!/usr/bin/env bash
# deadlift: the maintainer's command, run on their own computer.
#
# Usage:
#   deadlift server provision
#   deadlift server bootstrap <server>
#   deadlift server status <server>
#   deadlift app add <app> --server <server> --repo <owner/name> [--slots <n>] [--snapshots <n>] [--memory <size>] [--cpus <n>] [--pids <n>]
#   deadlift app secrets <app> dev|feature <file> --server <server>
#   deadlift app remove <app> --server <server> --yes
#   deadlift init <app> --server <server> [--branch <branch>] [--image <name>]...
#
#   server provision  A wizard that walks you through getting a new Server, step by step: the
#                     tailnet policy, buying the machine, the provider's firewall, bootstrap,
#                     joining the tailnet and closing public SSH. Stop it any time and run it
#                     again to carry on (see cli/provision.sh).
#   server bootstrap  Turns <server>, a fresh Ubuntu 24.04 machine or a Server already, into an up
#                     to date Server. It sends this checkout's server/, with the Server's
#                     Python from src/deadlift, over SSH as root and runs its bootstrap.sh
#                     there (see it for what it sets up). Safe to run again: a
#                     run with nothing to do changes nothing. <server> is anything `ssh root@`
#                     takes: the machine's public address before it joins the tailnet, its
#                     tailnet name after.
#   server status     Shows the Server's disk usage, and each App's ports, Slots in use, Volume
#                     Snapshots and Environments.
#   app add           Gives the App its place on the Server: its deploy user, deadlift-<app>,
#                     outside the docker group, one sudo rule for the entry command, a block of
#                     100 loopback ports and its settings (server/app.sh has the defaults). Then
#                     creates its Tailscale Service, svc:<app>, tagged tag:deadlift-svc and
#                     listing 443 and every Slot's port, 10000 + <slot>. Last, it prints the
#                     App's own tailnet policy entries and the federated credential its CI joins
#                     the tailnet with. The Service needs no entry: the provision wizard's cover
#                     every Service tagged tag:deadlift-svc. Safe to run again, and running it
#                     again with other settings changes them, keeping the App's ports.
#                       --repo       The App's GitHub repository, whose workflows deliver it.
#                       --slots      Feature Environments at once, 1 to 9.
#                       --snapshots  Volume Snapshots of the Dev Environment to keep.
#                       --memory, --cpus, --pids
#                                    The most memory (such as 512m), CPUs (such as 0.5) and
#                                    processes each of the App's containers may use.
#   app secrets       Puts <file>, an env file, on the Server as the App's secrets file for its
#                     Dev or its Feature Environments. Its variables reach the template from the
#                     next deploy of that kind on. Secrets never pass through CI.
#   app remove        Removes the App from the Server: every Environment with its volumes, its
#                     Volume Snapshots and secrets files, its deploy user and sudo rule, and its
#                     Tailscale Service. Its data is gone for good, hence --yes.
#   init              Writes the starter workflows into the App's repository, the one it's run
#                     in: deadlift-feature, deadlift-dev, deadlift-sweep and deadlift-rollback,
#                     delivering the App to <server>, with Dev tracking <branch> (main by
#                     default) and building each --image (web by default). They're the
#                     App's own from then on: running it again leaves any it has changed alone
#                     (see cli/init.sh).
#
# app add and app remove reach the Tailscale API with the maintainer's own credential, an API
# access token in TAILSCALE_API_KEY, for the tailnet in TAILSCALE_TAILNET (the token's own by
# default). The Server never holds a Tailscale credential (ADR 0003).
#
# Every reason line starts with `deadlift: `. Exit codes: 0 done, 1 failed, 2 refused or bad
# usage (nothing was changed).
#
# Settings, for the tests only: DEADLIFT_TAILSCALE_API, the Tailscale API's address.
set -euo pipefail

root=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# Installed by bootstrap: the Server half of the app and server status commands.
app_script=/usr/local/lib/deadlift/app.sh
tailscale_api=${DEADLIFT_TAILSCALE_API:-https://api.tailscale.com}

usage() {
  echo "deadlift: $1" >&2
  sed -n 's/^#   \(deadlift .*\)/Usage: \1/p' "${BASH_SOURCE[0]}" >&2
  exit 2
}

fail() {
  echo "deadlift: $1" >&2
  exit 1
}

check_server() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9.:-]*$ ]] || usage "'$1' isn't a host name or address"
}

# The same rule as the Server's app.sh, checked here too so a bad name changes nothing anywhere.
check_app() {
  [[ $1 =~ ^[a-z]([a-z0-9-]{0,21}[a-z0-9])?$ ]] ||
    usage "'$1' isn't an App name: up to 23 of a-z, 0-9 and -, starting with a letter and not ending with -"
  [[ ! $1 =~ -feature(-|$) ]] ||
    usage "'$1' isn't an App name: a part named feature after a - could clash with another App's Feature Environments"
}

# Runs the installed app.sh on the Server as root, with stdin passed on, and its output shown as
# it comes. Lines `deadlift-output: <name>=<value>` are kept in server_outputs, not shown.
server_outputs=''
on_server() {
  local server=$1 status=0 out
  shift
  out=$(mktemp)
  ssh -o StrictHostKeyChecking=accept-new "root@$server" "$app_script $(printf '%q ' "$@")" >"$out" ||
    status=$?
  server_outputs=$(grep '^deadlift-output: ' "$out" || true)
  grep -v '^deadlift-output: ' "$out" || true
  rm -f "$out"
  case $status in
    255) fail "couldn't reach $server over SSH as root, so nothing was changed." ;;
    127) fail "$server has no $app_script. Run \`deadlift server bootstrap $server\` to bring it up to date, then run this again." ;;
  esac
  return "$status"
}

# A Tailscale API call: <method> <path under the tailnet> [<JSON body>]. Sets api_status to the
# HTTP status (000 when the API couldn't be reached) and api_body to the response's body.
api_status='' api_body=''
tailscale_api() {
  local method=$1 path=$2 body=${3:-} out
  out=$(mktemp)
  local args=(--silent --show-error --request "$method" --output "$out" --write-out '%{http_code}'
    --header "Authorization: Bearer $TAILSCALE_API_KEY")
  if [[ -n $body ]]; then args+=(--header 'Content-Type: application/json' --data "$body"); fi
  api_status=$(curl "${args[@]}" "$tailscale_api/api/v2/tailnet/${TAILSCALE_TAILNET:--}/$path") ||
    api_status=000
  api_body=$(cat "$out")
  rm -f "$out"
}

require_api_key() {
  [[ -n ${TAILSCALE_API_KEY:-} ]] ||
    usage "$1 needs a Tailscale API access token in TAILSCALE_API_KEY, from the admin console's Settings, Keys. Nothing was changed"
  command -v jq >/dev/null || usage "$1 needs jq. Nothing was changed"
}

# Creates the App's Service, or brings its ports and tags up to date. Leaves it alone when it's
# right already.
ensure_service() {
  local app=$1 slots=$2 service=svc:$1 wanted s
  local ports=('"tcp:443"')
  for ((s = 1; s <= slots; s++)); do ports+=("\"tcp:$((10000 + s))\""); done
  wanted=$(jq -n --arg name "$service" --arg app "$app" --argjson ports "[$(IFS=, && echo "${ports[*]}")]" \
    '{name: $name, comment: "deadlift: the App \($app)", ports: $ports, tags: ["tag:deadlift-svc"]}')
  tailscale_api GET "vip-services/$service"
  if [[ $api_status == 200 ]] && jq -e --argjson wanted "$wanted" \
    '(.ports | sort) == ($wanted.ports | sort) and (.tags | sort) == $wanted.tags' <<<"$api_body" >/dev/null 2>&1; then
    echo "deadlift: the Tailscale Service $service is there already, listing 443 and the ports of $app's $slots Slots."
    return
  fi
  [[ $api_status == 200 || $api_status == 404 ]] ||
    fail "couldn't read the Tailscale Service $service from the Tailscale API (HTTP $api_status: $api_body). $app's place on the Server is ready; run \`deadlift app add\` again to create its Service"
  tailscale_api PUT "vip-services/$service" "$wanted"
  [[ $api_status == 200 ]] ||
    fail "couldn't create the Tailscale Service $service through the Tailscale API (HTTP $api_status: $api_body). $app's place on the Server is ready; run \`deadlift app add\` again to create its Service"
  echo "deadlift: created the Tailscale Service $service, tagged tag:deadlift-svc, listing 443 and the ports of $app's $slots Slots."
}

# The App's own entries in the tailnet policy, and its CI's federated credential.
print_policy() {
  local app=$1 repo=$2 tag=tag:deadlift-ci-$1
  cat <<EOF

Merge these entries into your tailnet policy. They let $app's CI, as $tag, reach only the
Server's SSH port, and log in only as $app's deploy user. Its Service, svc:$app, needs none: the
provision wizard's entries cover every Service tagged tag:deadlift-svc.

$(jq -n --arg tag "$tag" --arg user "deadlift-$app" '{
  tagOwners: {($tag): ["autogroup:admin"]},
  grants: [{src: [$tag], dst: ["tag:deadlift-server"], ip: ["tcp:22"]}],
  ssh: [{action: "accept", src: [$tag], dst: ["tag:deadlift-server"], users: [$user]}]
}')

Then give $app's CI a federated credential, so it joins the tailnet through GitHub's OIDC token
with no key to leak. In the Tailscale admin console, Settings, Trust credentials, add an OpenID
Connect credential:
  Issuer:    GitHub (https://token.actions.githubusercontent.com)
  Subject:   repo:$repo:*
             (if the repo customises its subject claim, use that form, from
             \`gh api repos/$repo/actions/oidc/customization/sub\`)
  Scopes:    Keys, Auth Keys: Write, with the tag $tag
and set its Client ID and Audience as the repo's variables, which deadlift's deliver action reads:
  gh variable set TS_OAUTH_CLIENT_ID --repo $repo --body <Client ID>
  gh variable set TS_AUDIENCE --repo $repo --body <Audience>
EOF
}

server_bootstrap() {
  (($# == 1)) || usage "server bootstrap needs one <server>"
  local server=$1 status=0
  check_server "$server"
  echo "Bootstrapping $server"
  # COPYFILE_DISABLE keeps macOS tar from adding ._ files. Commands on the Server read nothing from
  # the maintainer's terminal: stdin is the tar.
  # server/ at the top, with deadlift's Python for the Server beside it, as deadlift/ (ADR 0004).
  COPYFILE_DISABLE=1 tar -cf - --exclude __pycache__ -C "$root/server" . -C "$root/src" \
    deadlift/__init__.py deadlift/core deadlift/server deadlift/bootstrap |
    ssh -o StrictHostKeyChecking=accept-new "root@$server" \
      'd=$(mktemp -d) && tar -xf - -C "$d" --no-same-owner && "$d/bootstrap.sh"; s=$?; rm -rf "$d"; exit $s' ||
    status=$?
  if ((status == 255)); then
    echo "deadlift: couldn't reach $server over SSH as root, so nothing was changed." >&2
    exit 1
  fi
  return "$status"
}

server_status() {
  (($# == 1)) || usage "server status needs one <server>"
  check_server "$1"
  on_server "$1" status </dev/null
}

# Parses `<app> [positional...] --server <server> [options]` into app, server, positional and
# options (the other --name value pairs, and --yes).
parse_app_args() {
  app=${1:-}
  shift || true
  server='' positional=() options=()
  while (($#)); do
    case $1 in
      --server)
        [[ $# -ge 2 && -n $2 ]] || usage "--server needs a value"
        server=$2
        shift 2
        ;;
      --yes)
        options+=("$1")
        shift
        ;;
      --*)
        [[ $# -ge 2 ]] || usage "$1 needs a value"
        options+=("$1" "$2")
        shift 2
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done
  check_app "$app"
  [[ -n $server ]] || usage "--server is required"
  check_server "$server"
}

app_add() {
  local app server positional options repo='' server_args=() slots
  parse_app_args "$@"
  ((${#positional[@]} == 0)) || usage "unknown argument '${positional[0]}' for app add"
  set -- ${options[@]+"${options[@]}"}
  while (($#)); do
    case $1 in
      --repo) repo=$2 ;;
      --slots | --snapshots | --memory | --cpus | --pids) server_args+=("$1" "$2") ;;
      *) usage "unknown option $1 for app add" ;;
    esac
    shift 2
  done
  [[ $repo =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]] || usage "--repo needs the App's GitHub repository, as <owner>/<name>"
  require_api_key "app add"

  echo "Adding $app to $server"
  on_server "$server" add "$app" ${server_args[@]+"${server_args[@]}"} </dev/null
  slots=$(sed -n 's/^deadlift-output: slots=//p' <<<"$server_outputs")
  [[ $slots =~ ^[1-9]$ ]] || fail "$server didn't say how many Slots $app has. Run \`deadlift server bootstrap $server\`, then this again"
  ensure_service "$app" "$slots" >&2
  print_policy "$app" "$repo"
}

app_secrets() {
  local app server positional options kind file
  parse_app_args "$@"
  ((${#options[@]} == 0)) || usage "unknown option ${options[0]} for app secrets"
  ((${#positional[@]} == 2)) || usage "app secrets needs dev or feature, and a file"
  kind=${positional[0]} file=${positional[1]}
  [[ $kind == dev || $kind == feature ]] || usage "app secrets is for dev or feature, not '$kind'"
  [[ -f $file && -r $file ]] || usage "there's no file to read at $file"
  on_server "$server" secrets "$app" "$kind" <"$file"
}

app_remove() {
  local app server positional options
  parse_app_args "$@"
  ((${#positional[@]} == 0)) || usage "unknown argument '${positional[0]}' for app remove"
  [[ ${options[*]-} == --yes ]] ||
    usage "app remove destroys every Environment of $app with its data, for good. Run it again with --yes to go ahead. Nothing was changed"
  require_api_key "app remove"

  echo "Removing $app from $server"
  on_server "$server" remove "$app" </dev/null
  tailscale_api DELETE "vip-services/svc:$app"
  case $api_status in
    200 | 204) echo "deadlift: deleted the Tailscale Service svc:$app." >&2 ;;
    404) echo "deadlift: there's no Tailscale Service svc:$app, so there was none to delete." >&2 ;;
    *) fail "$app is off $server, but its Tailscale Service svc:$app couldn't be deleted (HTTP $api_status: $api_body). Run \`deadlift app remove\` again" ;;
  esac
}

case "${1:-} ${2:-}" in
  "server provision")
    (($# == 2)) || usage "server provision takes no arguments: it asks for what it needs"
    exec "$root/cli/provision.sh"
    ;;
  "server bootstrap") shift 2 && server_bootstrap "$@" ;;
  "server status") shift 2 && server_status "$@" ;;
  "app add") shift 2 && app_add "$@" ;;
  "app secrets") shift 2 && app_secrets "$@" ;;
  "app remove") shift 2 && app_remove "$@" ;;
  "init "*) shift && exec "$root/cli/init.sh" "$@" ;;
  *) usage "'${*}' isn't a command" ;;
esac
